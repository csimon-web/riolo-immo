<div class="card mb-4">
    {% if property.picture %}
        <img src="{{ vich_uploader_asset(property.picture, 'imageFile') | imagine_filter('thumb') }}" alt="{{ property.title }}" class="card-img-top">
    {% else %}
        <img src="{{ '/images/empty.jpg' | imagine_filter('thumb') }}"  alt="Aucune photo disponible" class="card-img-top">
    {% endif %}
    <div class="card-body">
        <h5 class="card-title">
            <a href="{{ path('app.property.show', {slug: property.slug, id: property.id}) }}">
                {{ property.title }}
            </a>
        </h5>
        <p class="card-text">
            {{ property.description | nl2br }}
        </p>
        <p class="card-text">
            {{ property.surface }} m² - {{ property.city }} ({{ property.postalCode }})
        </p>
        <div class="text-primary fs-2 fw-bold">
            {{ property.formattedPrice }} €
        </div>
    </div>
</div>
