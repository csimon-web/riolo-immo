<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>{% block title %}Riolo Immo{% endblock %}</title>

        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🏠</text></svg>">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center gap-2"
                   href="{{ path('app.home') }}">
                    <i class="bi bi-house-door-fill fs-4" aria-hidden="true"></i>
                    <span>Riolo Immo</span>
                </a>

                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false"
                    aria-label="Ouvrir le menu de navigation"
                >
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">

                    {# Public navigation #}
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a
                                class="nav-link {% if app.request.attributes.get('_route') starts with 'app.property.' %}active{% endif %}"
                                href="{{ path('app.property.index') }}"
                            >
                                Nos biens
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                class="nav-link {% if app.request.attributes.get('_route') == 'app.contact' %}active{% endif %}"
                                href="{{ path('app.contact') }}"
                            >
                                Contact
                            </a>
                        </li>

                    </ul>

                    {# Private area: login, role-based menus, and logout #}
                    <ul class="navbar-nav ms-lg-auto">
                        <li class="nav-item dropdown">

                            <button
                                class="nav-link dropdown-toggle private-space-toggle d-flex align-items-center gap-2 text-start border-0 w-100"
                                id="privateSpaceDropdown"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Ouvrir le menu de l'espace privé"
                            >
                                <i class="bi bi-person-circle fs-3" aria-hidden="true"></i>

                                <span class="fw-semibold">
                                    {% if app.user %}
                                        {{ app.user.firstName }} {{ app.user.lastName }}
                                    {% else %}
                                        Espace privé
                                    {% endif %}
                                </span>
                            </button>

                            <ul
                                class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="privateSpaceDropdown"
                            >

                                {% if not app.user %}

                                    <li>
                                        <a class="dropdown-item" href="{{ path('app.login') }}">
                                            <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>
                                            Se connecter
                                        </a>
                                    </li>

                                {% else %}

                                    {# Menus for agents and administrators #}
                                    {% if is_granted('ROLE_AGENT') %}
                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="{{ path('app.admin.property.index') }}"
                                            >
                                                <i class="bi bi-houses me-2" aria-hidden="true"></i>
                                                Gestion des biens
                                            </a>
                                        </li>
                                    {% endif %}

                                    {# Menus restricted to administrators #}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <h6 class="dropdown-header">Administration</h6>
                                        </li>

                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="{{ path('app.admin.option.index') }}"
                                            >
                                                <i class="bi bi-sliders me-2" aria-hidden="true"></i>
                                                Gestion des options
                                            </a>
                                        </li>

                                        <li>
                                            <a
                                                class="dropdown-item"
                                                href="{{ path('app.admin.user.index') }}"
                                            >
                                                <i class="bi bi-people me-2" aria-hidden="true"></i>
                                                Gestion des agents
                                            </a>
                                        </li>
                                    {% endif %}

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item" href="{{ path('app.logout') }}">
                                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>
                                            Se déconnecter
                                        </a>
                                    </li>

                                {% endif %}

                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>

        <main class="container my-4">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fermer"
                    ></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Fermer"
                    ></button>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>